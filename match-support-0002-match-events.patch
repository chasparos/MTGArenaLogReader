+    }
+
+    public synchronized boolean recordGameResult(int gameNumber, GameResult result) {
+        if (gameNumber <= 0 || result == null || completedGames.containsKey(gameNumber)) return false;
+        completedGames.put(gameNumber, result);
+        return true;
+    }
